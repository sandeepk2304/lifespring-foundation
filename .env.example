# Canonical URL used for SEO, the sitemap and social cards
NEXT_PUBLIC_SITE_URL=https://www.your-charity.org

# Donations: pick ONE
# a) Stripe Checkout (one-time and monthly). Use a restricted key with Checkout Sessions: write.
STRIPE_SECRET_KEY=
# b) Or a hosted payment page; {amount} and {frequency} are filled in for you.
#    e.g. https://www.giving.sg/your-charity  or a Stripe Payment Link
NEXT_PUBLIC_DONATE_URL=

# Forms (volunteer, contact, newsletter) are emailed through Resend
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@your-charity.org
# A sender on a domain verified in Resend
ENQUIRY_FROM_EMAIL=Your Charity website <website@your-charity.org>
